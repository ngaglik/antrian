# ── Mode DEVELOPMENT (vite dev, `npm run dev`) ─────────────────────────────
# Alamat backend — dipakai sebagai target dev proxy Vite (lihat vite.config.ts).
# Ganti bila backend berjalan di host/port lain.
# Backend Configuration
VITE_APP_ID=ANTRIAN
VITE_BACKEND_URL=http://localhost:8000
VITE_TOKEN_NAME=tokenANTRIAN
VITE_SESSION_NAME=sessionANTRIAN

# Base URL API untuk browser.
# Biarkan KOSONG agar request bersifat relatif → lewat proxy Vite (same-origin,
# bebas CORS). Diisi hanya bila memang ingin memanggil API secara langsung
# (origin frontend dev http://localhost:5180 harus diizinkan CORS di backend).
VITE_API_BASE=

# Id aplikasi yang dikirim saat login (menentukan sesi per-aplikasi di backend).
#VITE_APP_ID=antrianhttp://localhost:8000
