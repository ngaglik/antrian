# ── Mode PRODUCTION (vite build) ───────────────────────────────────────────
# Frontend di-serve di belakang nginx yang juga mem-proxy "/api" ke backend,
# sehingga request cukup relatif (same-origin) dan tidak perlu CORS.
#
# VITE_BACKEND_URL hanya dipakai dev proxy (mode development), jadi tidak
# berpengaruh pada hasil build produksi.
# Backend Configuration
VITE_APP_ID=ANTRIAN
VITE_BACKEND_URL=https://hris.rspaw.or.id
VITE_TOKEN_NAME=tokenANTRIAN
VITE_SESSION_NAME=sessionANTRIAN

# Base URL API untuk browser.
# KOSONG (default) = same-origin → nginx mem-proxy "/api" ke backend.
# Isi bila API berada di origin LAIN, contoh:
#   VITE_API_BASE=https://inova.rspaw.or.id
# (origin tersebut harus diizinkan CORS di erp/backend/Program.cs).
VITE_API_BASE=https://hris.rspaw.or.id

# Id aplikasi yang dikirim saat login (menentukan sesi per-aplikasi di backend).
#VITE_APP_ID=antrianhttps://hris.rspaw.or.id
